# Copie este ficheiro para backend/.env e preencha os valores.
# NUNCA comite o backend/.env com valores reais (já está no .gitignore da raiz).

# --- Base de dados ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/zana?schema=public"

# --- Servidor ---
PORT=3001
NODE_ENV=development
APP_BASE_URL="http://localhost:5173"
CORS_ORIGIN="http://localhost:5173"

# --- Autenticação ---
# OBRIGATÓRIO em produção: string aleatória longa (ex.: `openssl rand -hex 32`).
# Se ficar por definir, o servidor recusa arrancar quando NODE_ENV=production.
AUTH_SECRET="change-me-generate-a-strong-random-secret"
AUTH_TOKEN_TTL_SECONDS=2592000
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600

# --- Conta de admin (painel /admin) ---
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
# ADMIN_RESET_PASSWORD=true

# --- Email: SendGrid (opcional) ---
# SENDGRID_API_KEY=
# SENDGRID_FROM=
# SENDGRID_TIMEOUT_MS=10000

# --- Email: SMTP (alternativa ao SendGrid) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_CONNECTION_TIMEOUT_MS=10000
# SMTP_GREETING_TIMEOUT_MS=10000
# SMTP_SOCKET_TIMEOUT_MS=10000

# --- Dados da loja (usados em emails/notificações) ---
# STORE_NAME=
# STORE_EMAIL=
# STORE_PHONE=
# STORE_WHATSAPP=
# STORE_ADDRESS=
# STORE_INSTAGRAM=

# --- Lembretes de marcações ---
# APPOINTMENT_REMINDER_HOURS=24
# APPOINTMENT_REMINDER_SWEEP_MS=900000
